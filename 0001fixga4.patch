-/* ===== COOKIE + GA (consent gated) ===== */
+/* ===== ANALYTICS + ADS CONSENT =====
+   Analytics (GA4) runs by default on a statistical-purposes basis under
+   PECR Schedule A1 (as inserted by the Data (Use and Access) Act 2025):
+   aggregate site-improvement stats only. Google signals, ad personalisation
+   and ad storage are all explicitly denied, so nothing here feeds advertising.
+   Visitors get clear notice and a one-click way to object (ckOptOut, plus the
+   persistent "Analytics settings" link in the footer).
+
+   The OpenAI ads pixel and any Google Ads features are NOT covered by that
+   exception and remain strictly opt-in. */
 var cookie = document.getElementById('cookie');
+
+function analyticsOff(){
+  try { return localStorage.getItem('rdh_analytics') === 'off'; } catch(e){ return false; }
+}
+function adsConsented(){
+  try { return localStorage.getItem('rdh_consent') === 'yes'; } catch(e){ return false; }
+}
+
 function loadGA(){
+  if(window.gtag) return;                       // already loaded
+  window['ga-disable-' + GA_ID] = false;
   var s = document.createElement('script');
   s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
   document.head.appendChild(s);
   window.dataLayer = window.dataLayer || [];
   function gtag(){ dataLayer.push(arguments); }
   window.gtag = gtag;
+  /* Statistical purposes only until the visitor opts in to advertising. */
+  gtag('consent', 'default', {
+    ad_storage: 'denied',
+    ad_user_data: 'denied',
+    ad_personalization: 'denied',
+    analytics_storage: 'granted'
+  });
   gtag('js', new Date());
-  gtag('config', GA_ID);
+  gtag('config', GA_ID, {
+    anonymize_ip: true,
+    allow_google_signals: false,
+    allow_ad_personalization_signals: false
+  });
+  if(adsConsented()) grantAds();
 }
-/* OpenAI Ads pixel - only initialises after analytics/advertising consent */
+function grantAds(){
+  if(typeof window.gtag !== 'function') return;
+  window.gtag('consent', 'update', {
+    ad_storage: 'granted',
+    ad_user_data: 'granted',
+    ad_personalization: 'granted'
+  });
+}
+/* OpenAI Ads pixel - opt-in only, never fires without explicit consent */
 function loadPixel(){
   if(window.oaiq) return;                       // already loaded
   (function(w,d,s,u){
@@ -1096,31 +1135,54 @@ function loadPixel(){
 }
 function setConsent(v){
   try{ localStorage.setItem('rdh_consent', v); }catch(e){}
-  cookie.classList.remove('show');
   if(v === 'yes'){
-    loadGA(); loadPixel();
+    loadPixel(); grantAds();
   } else if(window.oaiq){
     window.oaiq('consent', false);                  // purges its queue and cookies
   }
 }
+function setAnalytics(on){
+  try{ localStorage.setItem('rdh_analytics', on ? 'on' : 'off'); }catch(e){}
+  if(on){ loadGA(); return; }
+  window['ga-disable-' + GA_ID] = true;             // stops any further GA4 hits
+  setConsent('no');                                 // opting out of stats opts out of ads too
+}
+function dismissNotice(){
+  try{ localStorage.setItem('rdh_notice', 'seen'); }catch(e){}
+  if(cookie) cookie.classList.remove('show');
+}
+window.RDHPrivacy = { setAnalytics: setAnalytics, setConsent: setConsent,
+  open: function(){ if(cookie) cookie.classList.add('show'); } };
+
 (function(){
-  var c = null;
